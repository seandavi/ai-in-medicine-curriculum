{
  // Cloudflare Workers Static Assets deployment, same pattern as ../talks.
  // Assets-only (no Worker script): the Quarto output in _book/ is served
  // from the edge. Deploy with `npm run deploy` after `quarto render`, or
  // let .github/workflows/deploy.yml do both on push to main.
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration/schema.json",
  "name": "ai-in-medicine",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./_book",
    "not_found_handling": "404-page"
  },
  // Custom domain on the seandavis.net zone (same Cloudflare account as ../talks).
  // Wrangler turns the workers.dev address off once a route exists unless told
  // otherwise; keep it on so links already shared keep working.
  "workers_dev": true,
  "routes": [
    { "pattern": "aim.seandavis.net", "custom_domain": true }
  ]
}
